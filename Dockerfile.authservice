# ---- build stage ----
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/authservice ./cmd/authservice

# ---- run stage ----
FROM gcr.io/distroless/static-debian12
COPY --from=build /bin/authservice /bin/authservice
EXPOSE 50052
ENTRYPOINT ["/bin/authservice"]
