# ---- build stage ----
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/worker ./cmd/worker

# ---- run stage ----
FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /bin/worker /bin/worker
ENTRYPOINT ["/bin/worker"]
